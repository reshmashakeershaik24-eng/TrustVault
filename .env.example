# ==========================================
# TrustVault Environment Variables Template
# Copy this file to .env and customize values
# ==========================================

# Application Settings
PROJECT_NAME="TrustVault"
VERSION="1.0.0"

# JWT Authentication Secret Key (Generate a random 32-byte secret in production)
SECRET_KEY="replace-with-a-secure-random-jwt-secret-key"

# Default Demo User Password (used by seeder for initial evaluation accounts)
DEFAULT_USER_PASSWORD="1234"

# Database Connection (Default: SQLite local database file)
DATABASE_URL="sqlite:///./trustvault.db"

# AI Permission Suggestion API Key (Optional Groq API key for LLaMA 3.3)
GROQ_API_KEY=""

